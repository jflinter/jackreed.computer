# MapTiler key for the route maps on /alaska-2026.
# Create one at https://cloud.maptiler.com/account/keys/
#
# This is a static site, so the key is inlined into the client bundle at build
# time and is public once deployed. That's normal for MapTiler; restrict it by
# origin in their dashboard if you want to limit abuse.
#
# Set the same variable in the Cloudflare Workers Build environment, or the
# maps render as placeholders in production while working fine locally.
PUBLIC_MAPTILER_KEY=
